    {
      "name": "Offering Management",
      "item": [
        {
          "name": "Create Offering (Teacher)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "UserId",
                "value": "teacher-id-123",
                "description": "ID of the Teacher creating the offering"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": 1,\n  \"title\": \"Advanced Java - Spring 2026 Batch\",\n  \"timezone\": \"America/New_York\",\n  \"maxCapacity\": 15\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/offerings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "offerings"
              ]
            },
            "description": "Creates a new class offering for a course. Restricted to TEACHER roles."
          },
          "response": []
        },
        {
          "name": "Add Sessions to Offering (Teacher)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "UserId",
                "value": "teacher-id-123",
                "description": "ID of the Teacher who owns the offering"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessions\": [\n    {\n      \"startTime\": \"2026-06-15T09:00:00Z\",\n      \"endTime\": \"2026-06-15T11:00:00Z\"\n    },\n    {\n      \"startTime\": \"2026-06-17T09:00:00Z\",\n      \"endTime\": \"2026-06-17T11:00:00Z\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/offerings/1/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "offerings",
                "1",
                "sessions"
              ]
            },
            "description": "Adds schedule slots (sessions) to an offering. Enforces validation to prevent internal session overlapping."
          },
          "response": []
        },
        {
