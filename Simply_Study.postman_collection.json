            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"teacher-id-123\",\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.doe@simplystudy.com\",\n  \"role\": \"TEACHER\",\n  \"timezone\": \"America/New_York\"\n}"
            },
